<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="InteractionPromptContainer" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; justify-content: center; align-items: center; display: none;">
        <ui:VisualElement style="background-color: rgba(0, 0, 0, 0.8); padding-left: 24px; padding-right: 24px; padding-top: 18px; padding-bottom: 18px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-left-radius: 12px; border-bottom-right-radius: 12px; align-items: center;">
            <ui:Label name="PromptTitle" text="Interact" style="unity-font-style: bold; font-size: 20px; color: rgb(255, 255, 255); margin-bottom: 12px;"/>
            <ui:VisualElement name="ButtonContainer" style="flex-direction: row; gap: 12px; align-items: center;"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="InteractionHint" style="position: absolute; bottom: 30px; left: 0; right: 0; justify-content: center; align-items: center; display: none;">
        <ui:VisualElement style="background-color: rgba(0, 0, 0, 0.6); padding-left: 16px; padding-right: 16px; padding-top: 12px; padding-bottom: 12px; border-radius: 8px; flex-direction: row; align-items: center; gap: 10px;">
            <ui:Label name="HintPrefix" text="Press" style="font-size: 24px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-font: resource(&quot;Assets/AssetLibrary/webfontkit-BoldPixels/BoldPixels.otf&quot;);"/>
            <ui:Image name="KeyIcon" style="width: 40px; height: 40px; background-image: url(&quot;project://database/Assets/AssetLibrary/Input%20Prompts/Source/Keyboard_Mouse/Dark/T_E_Key_Dark.png?fileID=2800000&amp;guid=6f2d7d85e92cbf240b99623742cc3890&amp;type=3#T_E_Key_Dark&quot;);"/>
            <ui:Label name="HintSuffix" text="to interact" style="font-size: 24px; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-font: resource(&quot;Assets/AssetLibrary/webfontkit-BoldPixels/BoldPixels.otf&quot;);"/>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="PlayerHUD" style="flex-grow: 1; position: absolute; width: 100%; height: 100%; left: -10px; top: -5px;">
        <ui:VisualElement name="HealthBackground" style="flex-grow: 1; height: 20px; position: absolute; top: 153px; left: 211px; background-image: url(&quot;project://database/Assets/AssetLibrary/Healthbar%20and%20Scroll/04.png?fileID=-2459961163305036784&amp;guid=58a5fbf28c739c44a85e47b6ace18b20&amp;type=3#04_1&quot;); -unity-background-image-tint-color: rgb(46, 46, 46); background-size: 100% 20px;"/>
        <ui:VisualElement name="Health" style="flex-grow: 0; position: absolute; height: 20px; top: 153px; left: 211px; background-image: url(&quot;project://database/Assets/AssetLibrary/Healthbar%20and%20Scroll/04.png?fileID=-2459961163305036784&amp;guid=58a5fbf28c739c44a85e47b6ace18b20&amp;type=3#04_1&quot;); flex-shrink: 0; background-size: 100% 20px;"/>
        <ui:VisualElement name="FpBackground" style="flex-grow: 0; position: absolute; top: 175px; left: 200px; height: 20px; background-image: url(&quot;project://database/Assets/AssetLibrary/Healthbar%20and%20Scroll/04.png?fileID=7651276893967259947&amp;guid=58a5fbf28c739c44a85e47b6ace18b20&amp;type=3#04_15&quot;); -unity-background-image-tint-color: rgb(46, 46, 46); flex-shrink: 0; background-size: 100% 20px;"/>
        <ui:VisualElement name="Fp" style="flex-grow: 0; position: absolute; height: 20px; top: 175px; left: 200px; flex-shrink: 0; background-image: url(&quot;project://database/Assets/AssetLibrary/Healthbar%20and%20Scroll/04.png?fileID=7651276893967259947&amp;guid=58a5fbf28c739c44a85e47b6ace18b20&amp;type=3#04_15&quot;); background-size: 100% 20px;"/>
        <ui:VisualElement name="StaminaBackground" style="flex-grow: 1; position: absolute; top: 195px; left: 196px; height: 20px; background-image: url(&quot;project://database/Assets/AssetLibrary/Healthbar%20and%20Scroll/04.png?fileID=-5189654929032258231&amp;guid=58a5fbf28c739c44a85e47b6ace18b20&amp;type=3#04_21&quot;); -unity-background-image-tint-color: rgb(46, 46, 46); background-size: 100% 20px;"/>
        <ui:VisualElement name="Stamina" style="position: absolute; top: 195px; left: 196px; flex-shrink: 0; background-image: url(&quot;project://database/Assets/AssetLibrary/Healthbar%20and%20Scroll/04.png?fileID=-5189654929032258231&amp;guid=58a5fbf28c739c44a85e47b6ace18b20&amp;type=3#04_21&quot;); height: 20px; background-size: 100% 20px;"/>
        <ui:VisualElement name="Star" style="flex-grow: 0; position: absolute; height: 152px; width: 163px; top: 95px; left: 110px; background-image: url(&quot;project://database/Assets/AssetLibrary/Healthbar%20and%20Scroll/00.png?fileID=-4465792008747384025&amp;guid=2aee64a84b6a3e0428c746710ca269d7&amp;type=3#00_54&quot;); flex-shrink: 0;"/>
    </ui:VisualElement>
    <ui:VisualElement name="BossHUD" style="flex-grow: 1; position: absolute; bottom: 80px; left: 50%; margin-left: -400px; width: 800px; opacity: 0;">
        <ui:VisualElement name="BossBarBackground" style="flex-grow: 1; position: absolute; height: 30px; background-image: url(&quot;project://database/Assets/AssetLibrary/Healthbar%20and%20Scroll/04.png?fileID=2036232964626684600&amp;guid=58a5fbf28c739c44a85e47b6ace18b20&amp;type=3#04_55&quot;); -unity-background-image-tint-color: rgb(43, 43, 43); bottom: 5px;"/>
        <ui:VisualElement name="BossBarFill" style="flex-grow: 1; position: absolute; height: 30px; background-image: url(&quot;project://database/Assets/AssetLibrary/Healthbar%20and%20Scroll/04.png?fileID=732574491&amp;guid=58a5fbf28c739c44a85e47b6ace18b20&amp;type=3#boss healthbar fill&quot;); bottom: 5px; -unity-background-image-tint-color: rgb(176, 32, 0); margin-right: 24px; margin-left: 24px;"/>
        <ui:VisualElement name="BossBarFrame" style="flex-grow: 1; position: absolute; background-image: url(&quot;project://database/Assets/AssetLibrary/Boss%20Sprites/HeatlhBar/GUISprite.png?fileID=144718679&amp;guid=88a18e766b0a96c41b7344083df91e9e&amp;type=3#TopFrame&quot;); width: 400px; bottom: 33px; height: 55px; margin-left: 200px;"/>
        <ui:VisualElement name="BossBarBottomFrame" style="flex-grow: 1; width: 400px; height: 24px; background-image: url(&quot;project://database/Assets/AssetLibrary/Boss%20Sprites/HeatlhBar/GUISprite.png?fileID=-459173372&amp;guid=88a18e766b0a96c41b7344083df91e9e&amp;type=3#BottomFrame&quot;); margin-left: 200px; top: 10px;"/>
        <ui:Label text="Shadow Warrior Malec" name="BossName" style="position: absolute; top: 35px; width: 800px; color: rgb(200, 200, 200); -unity-text-align: upper-center; font-size: 36px; -unity-font-definition: url(&quot;project://database/Assets/AssetLibrary/webfontkit-BoldPixels/BoldPixels.dfont?fileID=12800000&amp;guid=741273aac30f6cf4ca34f6eb9199297f&amp;type=3#BoldPixels&quot;);"/>
    </ui:VisualElement>
    <ui:VisualElement name="VictoryOverlay" style="flex-grow: 1; position: absolute; top: 0; left: 0; bottom: 0; right: 0; align-content: center; align-self: center; justify-content: center; opacity: 1; display: none; background-color: rgba(0, 0, 0, 0.88);">
        <ui:Label text="BOSS DEFEATED" name="VictoryText" style="font-size: 148px; -unity-font-definition: url(&quot;project://database/Assets/AssetLibrary/webfontkit-BoldPixels/boldpixels.ttf?fileID=12800000&amp;guid=ba8bd293a4f58764d8f66b3da0a7d204&amp;type=3#boldpixels&quot;); -unity-text-align: middle-center; background-color: rgba(0, 0, 0, 0); color: rgb(122, 28, 49); align-self: center; align-content: center;"/>
    </ui:VisualElement>
    <ui:VisualElement name="PauseMenuContainer" style="position: absolute; left: 0; right: 0; top: 0; bottom: 0; display: none; justify-content: center; align-items: center; background-color: rgba(0, 0, 0, 0.95);">
        <ui:VisualElement name="PausePanel" style="width: 820px; min-height: 430px; max-width: 84%; max-height: 82%; background-image: url(&quot;project://database/Assets/AssetLibrary/kenney_fantasy-ui-borders/PNG/Default/Panel/panel-000.png&quot;); -unity-background-image-tint-color: rgb(10, 17, 23); background-size: 100% 100%; padding-left: 24px; padding-right: 24px; padding-top: 24px; padding-bottom: 24px; flex-direction: column;">
            <ui:VisualElement name="PauseMainPage" style="flex-grow: 1; flex-direction: row; gap: 20px;">
                <ui:VisualElement style="width: 40%; min-width: 250px; background-image: url(&quot;project://database/Assets/AssetLibrary/kenney_fantasy-ui-borders/PNG/Default/Panel/panel-000.png&quot;); -unity-background-image-tint-color: rgb(14, 24, 31); background-size: 100% 100%; padding-left: 22px; padding-right: 22px; padding-top: 22px; padding-bottom: 22px; flex-direction: column;">
                    <ui:Label text="PAUSED" style="font-size: 62px; color: rgb(243, 239, 230); -unity-font: resource(&quot;Assets/AssetLibrary/webfontkit-BoldPixels/BoldPixels.otf&quot;); letter-spacing: 2px; margin-bottom: 12px;"/>
                    <ui:VisualElement style="width: 170px; height: 8px; background-image: url(&quot;project://database/Assets/AssetLibrary/kenney_fantasy-ui-borders/PNG/Default/Divider%20Fade/divider-fade-000.png&quot;); background-size: 100% 100%; margin-bottom: 18px;"/>
                    <ui:Label text="ESC" style="font-size: 16px; color: rgb(191, 212, 142); -unity-font: resource(&quot;Assets/AssetLibrary/webfontkit-BoldPixels/BoldPixels.otf&quot;); margin-bottom: 6px;"/>
                    <ui:Label text="Return to the game" style="font-size: 18px; color: rgb(231, 233, 232); margin-bottom: 22px;"/>
                    <ui:Label text="QUICK REFERENCE" style="font-size: 16px; color: rgb(191, 212, 142); -unity-font: resource(&quot;Assets/AssetLibrary/webfontkit-BoldPixels/BoldPixels.otf&quot;); margin-bottom: 12px;"/>
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                        <ui:Label text="Jump" style="font-size: 18px; color: rgb(243, 239, 230);"/>
                        <ui:VisualElement style="width: 38px; height: 38px; background-image: url(&quot;project://database/Assets/AssetLibrary/Input%20Prompts/Source/Keyboard_Mouse/Dark/T_W_Key_Dark.png&quot;); background-size: contain; background-repeat: no-repeat;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                        <ui:Label text="Dodge Roll" style="font-size: 18px; color: rgb(243, 239, 230);"/>
                        <ui:VisualElement style="width: 62px; height: 38px; background-image: url(&quot;project://database/Assets/AssetLibrary/Input%20Prompts/Source/Keyboard_Mouse/Dark/T_Space_Key_Dark.png&quot;); background-size: contain; background-repeat: no-repeat;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                        <ui:Label text="Light Attack" style="font-size: 18px; color: rgb(243, 239, 230);"/>
                        <ui:VisualElement style="width: 42px; height: 42px; background-image: url(&quot;project://database/Assets/AssetLibrary/Input%20Prompts/Source/Keyboard_Mouse/Dark/T_Mouse_Left_Key_Dark.png&quot;); background-size: contain; background-repeat: no-repeat;"/>
                    </ui:VisualElement>
                    <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;">
                        <ui:Label text="Interact" style="font-size: 18px; color: rgb(243, 239, 230);"/>
                        <ui:VisualElement style="width: 38px; height: 38px; background-image: url(&quot;project://database/Assets/AssetLibrary/Input%20Prompts/Source/Keyboard_Mouse/Dark/T_E_Key_Dark.png&quot;); background-size: contain; background-repeat: no-repeat;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement style="flex-grow: 1; background-image: url(&quot;project://database/Assets/AssetLibrary/kenney_fantasy-ui-borders/PNG/Default/Panel/panel-000.png&quot;); -unity-background-image-tint-color: rgb(16, 26, 34); background-size: 100% 100%; padding-left: 24px; padding-right: 24px; padding-top: 24px; padding-bottom: 24px; justify-content: center; align-items: center;">
                    <ui:Button name="ContinueButton" text="Continue" style="width: 220px; height: 46px; font-size: 18px; color: rgb(24, 28, 31); -unity-font-style: bold; background-color: rgb(240, 238, 232); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(165, 165, 165); border-right-color: rgb(165, 165, 165); border-top-color: rgb(235, 235, 235); border-bottom-color: rgb(122, 122, 122); margin-bottom: 16px;"/>
                    <ui:Button name="ControlsButton" text="Controls" style="width: 220px; height: 42px; font-size: 17px; color: rgb(32, 36, 40); -unity-font-style: bold; background-color: rgb(229, 227, 220); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(155, 155, 155); border-right-color: rgb(155, 155, 155); border-top-color: rgb(232, 232, 232); border-bottom-color: rgb(112, 112, 112); margin-bottom: 12px;"/>
                    <ui:Button name="NewGameButton" text="New Game" style="width: 220px; height: 42px; font-size: 17px; color: rgb(32, 36, 40); -unity-font-style: bold; background-color: rgb(229, 227, 220); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(155, 155, 155); border-right-color: rgb(155, 155, 155); border-top-color: rgb(232, 232, 232); border-bottom-color: rgb(112, 112, 112); margin-bottom: 12px;"/>
                    <ui:Button name="QuitButton" text="Quit Game" style="width: 220px; height: 42px; font-size: 17px; color: rgb(32, 36, 40); -unity-font-style: bold; background-color: rgb(229, 227, 220); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(155, 155, 155); border-right-color: rgb(155, 155, 155); border-top-color: rgb(232, 232, 232); border-bottom-color: rgb(112, 112, 112);"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="PauseControlsPage" style="flex-grow: 1; display: none; flex-direction: column;">
                <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                    <ui:Label text="CONTROLS" style="font-size: 46px; color: rgb(243, 239, 230); -unity-font: resource(&quot;Assets/AssetLibrary/webfontkit-BoldPixels/BoldPixels.otf&quot;); letter-spacing: 2px;"/>
                    <ui:Button name="BackButton" text="Back" style="width: 150px; height: 42px; font-size: 17px; color: rgb(32, 36, 40); -unity-font-style: bold; background-color: rgb(229, 227, 220); border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px; border-left-color: rgb(155, 155, 155); border-right-color: rgb(155, 155, 155); border-top-color: rgb(232, 232, 232); border-bottom-color: rgb(112, 112, 112);"/>
                </ui:VisualElement>
                <ui:VisualElement style="width: 200px; height: 8px; background-image: url(&quot;project://database/Assets/AssetLibrary/kenney_fantasy-ui-borders/PNG/Default/Divider%20Fade/divider-fade-000.png&quot;); background-size: 100% 100%; margin-bottom: 18px;"/>
                <ui:ScrollView style="flex-grow: 1;">
                    <ui:VisualElement style="flex-direction: row; gap: 16px; padding-left: 6px; padding-right: 6px; padding-top: 6px; padding-bottom: 6px;">
                        <ui:VisualElement style="flex-grow: 1; background-image: url(&quot;project://database/Assets/AssetLibrary/kenney_fantasy-ui-borders/PNG/Default/Panel/panel-000.png&quot;); -unity-background-image-tint-color: rgb(14, 24, 31); background-size: 100% 100%; padding-left: 18px; padding-right: 18px; padding-top: 18px; padding-bottom: 18px; flex-direction: column; gap: 12px;">
                            <ui:Label text="MOVEMENT" style="font-size: 22px; color: rgb(191, 212, 142); -unity-font: resource(&quot;Assets/AssetLibrary/webfontkit-BoldPixels/BoldPixels.otf&quot;);"/>
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;"><ui:Label text="Move Forward" style="font-size: 18px; color: rgb(243, 239, 230);"/><ui:VisualElement style="width: 38px; height: 38px; background-image: url(&quot;project://database/Assets/AssetLibrary/Input%20Prompts/Source/Keyboard_Mouse/Dark/T_D_Key_Dark.png&quot;); background-size: contain; background-repeat: no-repeat;"/></ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;"><ui:Label text="Move Backward" style="font-size: 18px; color: rgb(243, 239, 230);"/><ui:VisualElement style="width: 38px; height: 38px; background-image: url(&quot;project://database/Assets/AssetLibrary/Input%20Prompts/Source/Keyboard_Mouse/Dark/T_A_Key_Dark.png&quot;); background-size: contain; background-repeat: no-repeat;"/></ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;"><ui:Label text="Sprint" style="font-size: 18px; color: rgb(243, 239, 230);"/><ui:VisualElement style="flex-direction: row; align-items: center; gap: 6px;"><ui:VisualElement style="width: 54px; height: 38px; background-image: url(&quot;project://database/Assets/AssetLibrary/Input%20Prompts/Source/Keyboard_Mouse/Dark/T_Shift_Key_Dark.png&quot;); background-size: contain; background-repeat: no-repeat;"/><ui:Label text="+ D/A" style="font-size: 16px; color: rgb(243, 239, 230);"/></ui:VisualElement></ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;"><ui:Label text="Jump" style="font-size: 18px; color: rgb(243, 239, 230);"/><ui:VisualElement style="width: 38px; height: 38px; background-image: url(&quot;project://database/Assets/AssetLibrary/Input%20Prompts/Source/Keyboard_Mouse/Dark/T_W_Key_Dark.png&quot;); background-size: contain; background-repeat: no-repeat;"/></ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;"><ui:Label text="Dodge Roll" style="font-size: 18px; color: rgb(243, 239, 230);"/><ui:VisualElement style="width: 62px; height: 38px; background-image: url(&quot;project://database/Assets/AssetLibrary/Input%20Prompts/Source/Keyboard_Mouse/Dark/T_Space_Key_Dark.png&quot;); background-size: contain; background-repeat: no-repeat;"/></ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;"><ui:Label text="Climb Ladder (future)" style="font-size: 18px; color: rgb(243, 239, 230);"/><ui:VisualElement style="flex-direction: row; align-items: center; gap: 6px;"><ui:VisualElement style="width: 54px; height: 38px; background-image: url(&quot;project://database/Assets/AssetLibrary/Input%20Prompts/Source/Keyboard_Mouse/Dark/T_Shift_Key_Dark.png&quot;); background-size: contain; background-repeat: no-repeat;"/><ui:Label text="+ W" style="font-size: 16px; color: rgb(243, 239, 230);"/></ui:VisualElement></ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;"><ui:Label text="Descend Ladder (future)" style="font-size: 18px; color: rgb(243, 239, 230);"/><ui:VisualElement style="flex-direction: row; align-items: center; gap: 6px;"><ui:VisualElement style="width: 54px; height: 38px; background-image: url(&quot;project://database/Assets/AssetLibrary/Input%20Prompts/Source/Keyboard_Mouse/Dark/T_Shift_Key_Dark.png&quot;); background-size: contain; background-repeat: no-repeat;"/><ui:Label text="+ S" style="font-size: 16px; color: rgb(243, 239, 230);"/></ui:VisualElement></ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-grow: 1; background-image: url(&quot;project://database/Assets/AssetLibrary/kenney_fantasy-ui-borders/PNG/Default/Panel/panel-000.png&quot;); -unity-background-image-tint-color: rgb(14, 24, 31); background-size: 100% 100%; padding-left: 18px; padding-right: 18px; padding-top: 18px; padding-bottom: 18px; flex-direction: column; gap: 12px;">
                            <ui:Label text="COMBAT / ACTIONS" style="font-size: 22px; color: rgb(191, 212, 142); -unity-font: resource(&quot;Assets/AssetLibrary/webfontkit-BoldPixels/BoldPixels.otf&quot;);"/>
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;"><ui:Label text="Light Attack" style="font-size: 18px; color: rgb(243, 239, 230);"/><ui:VisualElement style="width: 42px; height: 42px; background-image: url(&quot;project://database/Assets/AssetLibrary/Input%20Prompts/Source/Keyboard_Mouse/Dark/T_Mouse_Left_Key_Dark.png&quot;); background-size: contain; background-repeat: no-repeat;"/></ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;"><ui:Label text="Heavy Attack" style="font-size: 18px; color: rgb(243, 239, 230);"/><ui:VisualElement style="flex-direction: row; align-items: center; gap: 6px;"><ui:VisualElement style="width: 54px; height: 38px; background-image: url(&quot;project://database/Assets/AssetLibrary/Input%20Prompts/Source/Keyboard_Mouse/Dark/T_Shift_Key_Dark.png&quot;); background-size: contain; background-repeat: no-repeat;"/><ui:Label text="+" style="font-size: 16px; color: rgb(243, 239, 230);"/><ui:VisualElement style="width: 42px; height: 42px; background-image: url(&quot;project://database/Assets/AssetLibrary/Input%20Prompts/Source/Keyboard_Mouse/Dark/T_Mouse_Left_Key_Dark.png&quot;); background-size: contain; background-repeat: no-repeat;"/></ui:VisualElement></ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;"><ui:Label text="Special Attack" style="font-size: 18px; color: rgb(243, 239, 230);"/><ui:VisualElement style="width: 42px; height: 42px; background-image: url(&quot;project://database/Assets/AssetLibrary/Input%20Prompts/Source/Keyboard_Mouse/Dark/T_Mouse_Right_Key_Dark.png&quot;); background-size: contain; background-repeat: no-repeat;"/></ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;"><ui:Label text="Use Flask (future)" style="font-size: 18px; color: rgb(243, 239, 230);"/><ui:VisualElement style="width: 38px; height: 38px; background-image: url(&quot;project://database/Assets/AssetLibrary/Input%20Prompts/Source/Keyboard_Mouse/Dark/T_R_Key_Dark.png&quot;); background-size: contain; background-repeat: no-repeat;"/></ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 10px;"><ui:Label text="Use Ultimate Art (future)" style="font-size: 18px; color: rgb(243, 239, 230);"/><ui:VisualElement style="width: 38px; height: 38px; background-image: url(&quot;project://database/Assets/AssetLibrary/Input%20Prompts/Source/Keyboard_Mouse/Dark/T_Q_Key_Dark.png&quot;); background-size: contain; background-repeat: no-repeat;"/></ui:VisualElement>
                            <ui:Label text="GAME" style="font-size: 22px; color: rgb(191, 212, 142); -unity-font: resource(&quot;Assets/AssetLibrary/webfontkit-BoldPixels/BoldPixels.otf&quot;); margin-top: 8px;"/>
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center;"><ui:Label text="Open Menu" style="font-size: 18px; color: rgb(243, 239, 230);"/><ui:VisualElement style="width: 54px; height: 38px; background-image: url(&quot;project://database/Assets/AssetLibrary/Input%20Prompts/Source/Keyboard_Mouse/Dark/T_Esc_Key_Dark.png&quot;); background-size: contain; background-repeat: no-repeat;"/></ui:VisualElement>
